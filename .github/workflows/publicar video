name:publicar.yml

on:
  schedule:  
    # Todos los dias a las 14:00 UTC. Para mas videos al dia, agrega mas lineas
    # con otras horas, por ejemplo: - cron: "0 20 * * *"
    - cron: "0 14 * * *"
  workflow_dispatch:
    inputs:
      privacidad:
        description: "Privacidad del video (private, unlisted o public)"
        default: "private"
        type: choice
        options: [private, unlisted, public]
      cantidad:
        description: "Cuantos videos crear en esta ejecucion"
        default: "1"
        type: string

permissions:
  contents: write

concurrency:
  group: publicar-video
  cancel-in-progress: false

jobs:
  publicar:
    runs-on: ubuntu-latest
    timeout-minutes: 40
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: "3.11"
          cache: pip

      - name: Instalar FFmpeg y fuentes
        run: |
          sudo apt-get update
          sudo apt-get install -y ffmpeg fonts-dejavu-core

      - name: Instalar librerias de Python
        run: pip install -r requirements.txt

      - name: Crear y publicar el video
        env:
          GROQ_API_KEY: ${{ secrets.GROQ_API_KEY }}
          PIXABAY_API_KEY: ${{ secrets.PIXABAY_API_KEY }}
          YT_CLIENT_ID: ${{ secrets.YT_CLIENT_ID }}
          YT_CLIENT_SECRET: ${{ secrets.YT_CLIENT_SECRET }}
          YT_REFRESH_TOKEN: ${{ secrets.YT_REFRESH_TOKEN }}
          # CAMBIA 'private' POR 'public' CUANDO YA HAYAS REVISADO QUE LOS VIDEOS SALEN BIEN
          PRIVACIDAD: ${{ github.event.inputs.privacidad || 'private' }}
          CANTIDAD: ${{ github.event.inputs.cantidad || '1' }}
          NOMBRE_CANAL: "Qué Pasa y Por Qué"
          VOZ: "es-MX-JorgeNeural"
          SEGUNDOS_VIDEO: "60"
        run: python generar_video.py

      - name: Guardar historial (para no repetir temas)
        if: always()
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add historial.json
          git diff --staged --quiet || (git commit -m "Actualizar historial" && git push)
